# === BotHosting : upload ce fichier en /home/container/.env ===
# Vercel : BOXPLUS_BOT_URL=http://prem-eu1.bot-hosting.net:20311

# Repo bot (bootstrap.js / index.js racine BotHosting)
BOT_REPO_URL=https://github.com/angoularaphael/boxi-deci-bot.git
BOT_REPO_BRANCH=main
BOT_APP_DIR=boxi-deci-bot-app
# Commande démarrage recommandée: node bootstrap.js
# (ou node start.js si le repo est monté à la racine du container)

# Deciplus
DECIPLUS_URL=https://boxingcenter.deciplus.pro/
DECIPLUS_USER=RAPHAEL
DECIPLUS_PASSWORD=Boxingcenter31
DECIPLUS_DEFAULT_SITE=Minimes
DECIPLUS_HEADLESS=true
DECIPLUS_NAV_TIMEOUT=90000
DECIPLUS_NAV_SETTLE_MS=1500
# Badge : prélèvement IBAN différé (~72h = 3 jours calendaires)
BADGE_PRELEVEMENT_DELAY_DAYS=3
BADGE_PRELEVEMENT_DELAY_MIN=3
BADGE_PRELEVEMENT_DELAY_MAX=3
# Code email Deciplus — lecture auto via IMAP (comptaboxing@gmail.com)
DECIPLUS_IMAP_USER=comptaboxing@gmail.com
DECIPLUS_IMAP_PASS=dtrb bhza puez ubxh
DECIPLUS_IMAP_HOST=imap.gmail.com
DECIPLUS_IMAP_PORT=993
# DECIPLUS_OTP_WAIT_MS=900001
# Repli manuel si IMAP KO :
# DECIPLUS_EMAIL_CODE=123456
# Ou token API (localStorage auth.token) — évite login :
# DECIPLUS_AUTH_TOKEN=

# Bot — port BotHosting (panel → Settings → port affiché)
BOT_DATA_DIR=data
BOT_SESSION_DIR=data/session
BOT_HTTP_PORT=20311
BOT_MAX_RETRIES=3
BOT_POLL_MS=5000
# Ping session Deciplus toutes les 1h30 — si morte → login + IMAP + sauvegarde
BOT_SESSION_KEEPALIVE_MS=5400000
BOT_SESSION_KEEPALIVE_RETRY_MS=600000
BOT_KEEPALIVE_CHECK_MS=60000
BOT_CATALOG_PUSH_ENABLED=true
BOT_CATALOG_PUSH_MS=21600000
BOT_CATALOG_PUSH_DELAY_MS=120000

# Playwright (dossiers relatifs → /home/container/data/...)
BOXPLUS_HOSTED=1
PLAYWRIGHT_BROWSERS_PATH=data/ms-playwright
TMPDIR=data/tmp

# Lien boutique Vercel
SYNC_SECRET=boxplus-bc-2026-test
STORE_INGEST_URL=https://box-plus.vercel.app/api/admin/ingest-catalog
BOXPLUS_STORE_URL=https://box-plus.vercel.app
STORE_URL=https://box-plus.vercel.app

ALERT_WEBHOOK_URL=
ALERT_EMAIL=
