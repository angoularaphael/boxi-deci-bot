# Deciplus
DECIPLUS_URL=https://boxingcenter.deciplus.pro/
DECIPLUS_USER=
DECIPLUS_PASSWORD=
DECIPLUS_HEADLESS=true
DECIPLUS_SLOW_MO=50
DECIPLUS_DEFAULT_SITE=Minimes
# Accélère vérif / résiliation / changement (délais Playwright ×0.3)
DECIPLUS_FAST=1

# Bot
BOT_DATA_DIR=data
BOT_SESSION_DIR=data/session
BOT_HTTP_PORT=3050
BOT_ROLE=sales
BOT_ID=raphael
BOT_LEASE_SECONDS=1800
BOT_MAX_RETRIES=3
BOT_MAX_FAILOVERS=1
BOT_FAILOVER_AFTER_ATTEMPTS=1
# Bot de secours du bot principal seulement (laisser vide sur le second bot pour éviter les boucles)
BOT_FAILOVER_TARGET=eddy
BOT_FAILOVER_URL=http://prem-eu2.bot-hosting.net:21871
BOT_POLL_MS=5000
BOT_CATALOG_PUSH_ENABLED=true
BOT_CATALOG_PUSH_MS=21600000
# Keepalive session Deciplus (token ~4h) — ping toutes les 2h30
BOT_SESSION_KEEPALIVE_MS=9000000
BOT_SESSION_KEEPALIVE_RETRY_MS=900000
BOT_KEEPALIVE_CHECK_MS=60000
# Cooldown après échec MFA (évite rafale d'emails code Deciplus)
BOT_AUTH_COOLDOWN_MS=600000

# Registre partagé de fiabilité / idempotence (service_role uniquement, jamais côté client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nettoyage ventes test — scan IDs Deciplus (optionnel)
CLEANUP_SCAN_ID_RANGE=20899-20950

# Auto-migration Balma sur toutes les ventes (0 = seulement page Aventure)
BALMA_AUTOMIGRATE_ON_SALE=0
BADGE_PRELEVEMENT_DELAY_DAYS=3
BADGE_PRELEVEMENT_DELAY_MIN=3
BADGE_PRELEVEMENT_DELAY_MAX=3

# Push catalogue → boutique (Vercel)
STORE_INGEST_URL=https://boutique.boxingcenter.fr/api/admin/ingest-catalog
BOXPLUS_STORE_URL=https://boutique.boxingcenter.fr
STORE_URL=https://boutique.boxingcenter.fr
SYNC_SECRET=change-me-in-production

# Brevo (autres emails bot si besoin — alerte « nouveau membre » admin désactivée)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=suzinabot@gmail.com
BREVO_SENDER_NAME=Boxing Center
ADMIN_EMAIL=
ALERT_EMAIL=boxingcentertls@gmail.com
ALERT_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@boxingcenter.fr
RESEND_SENDER_NAME=Boxing Center
RESEND_REPLY_TO=boxingcentertls@gmail.com
